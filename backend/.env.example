# OrynexOpsera backend — copy to .env and fill in. NO secrets are hardcoded in code.
# Without SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY the API runs in DEV MODE
# with an empty in-memory repository (clearly logged; data is lost on restart).

OPSERA_ENV=development
OPSERA_API_PREFIX=/api/v1

# Supabase (optional in Phase 1 dev mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
OPSERA_SUPABASE_SCHEMA=opsera

# ORYNEX CORE (Phase 6) — empty = core_sdk reports not_configured
ORYNEX_CORE_BASE_URL=
ORYNEX_CORE_API_KEY=

# Integration credentials (presence flips an integration from
# not_configured -> configured_unverified; live adapters ship in Phase 3/4)
GITHUB_TOKEN=
GMAIL_OAUTH_CLIENT_ID=
SLACK_BOT_TOKEN=
STRIPE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CANVA_API_KEY=
FIGMA_ACCESS_TOKEN=
